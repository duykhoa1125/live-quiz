# Copy to a protected env file outside Git on each EC2 instance (e.g. /etc/quizlab/env)
PORT=3000
BACKEND_ID=A

# ElastiCache for Valkey (node-based, cluster mode disabled, TLS + RBAC)
VALKEY_HOST=<VALKEY_ENDPOINT>
VALKEY_PORT=6379
VALKEY_TLS=true
VALKEY_USERNAME=<VALKEY_RBAC_USERNAME>
VALKEY_PASSWORD=<VALKEY_RBAC_PASSWORD>
VALKEY_TLS_REJECT_UNAUTHORIZED=true
